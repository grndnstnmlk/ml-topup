# Salin file ini menjadi .env lalu isi dengan kredensial asli Anda

PORT=3000

# Lokasi file database SQLite. Kosongkan untuk pakai folder project (default).
# Di hosting seperti Railway, arahkan ke folder persistent volume, contoh:
# DB_PATH=/app/data/data.sqlite
DB_PATH=

# Ambil dari dashboard Midtrans (https://dashboard.midtrans.com)
# Gunakan kredensial SANDBOX dulu untuk testing, baru ganti ke PRODUCTION saat live
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# URL website Anda (dipakai untuk redirect setelah pembayaran)
APP_BASE_URL=http://localhost:3000

# (Opsional, lihat README) Kredensial supplier diamond ML,
# contoh: Digiflazz, VIP Reseller, dsb — untuk pengiriman diamond otomatis
SUPPLIER_API_KEY=
SUPPLIER_USERNAME=

# Kredensial Digiflazz (ambil dari Pengaturan Koneksi API > API)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_DEV_KEY=
DIGIFLAZZ_PROD_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=

# API Key Velixs ID Game Checker (cek nickname, opsional/gratis)
VELIXS_API_KEY=

# Notifikasi Email (Resend — API berbasis HTTP, tidak diblokir hosting cloud)
# Daftar gratis di https://resend.com (3.000 email/bulan gratis, tanpa perlu
# verifikasi domain dulu — bisa langsung pakai alamat pengirim @resend.dev)
RESEND_API_KEY=
RESEND_FROM=GREEND TOP UP <onboarding@resend.dev>

# Notifikasi WhatsApp (Fonnte)
FONNTE_TOKEN=
